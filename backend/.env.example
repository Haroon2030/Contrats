# ---- التطوير المحلي: SQLite (يُنشأ الجدول تلقائياً) ----
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/dev.sqlite3
# حسابات تجريبية (كلمة المرور Demo12345) + موردون وفروع. للتطوير فقط.
DEV_SEED=1

# ---- الإنتاج: MySQL ----
# DB_DRIVER=mysql
# MYSQL_HOST=...
# MYSQL_PORT=3306
# MYSQL_DATABASE=...
# MYSQL_USER=...
# MYSQL_PASSWORD=...
# إنشاء الجداول: 1 في أول نشر على قاعدة فارغة، ثم 0 (الافتراضي مع MySQL).
# DB_SYNC=1

# مسؤول النظام الأول: يُنشأ عند الإقلاع إن لم يوجد مسؤول نظام (غيّر كلمة المرور بعد أول دخول).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-1
# BOOTSTRAP_ADMIN_NAME=مسؤول النظام
# BOOTSTRAP_ADMIN_EMAIL=

MEDIA_ROOT=./data/media
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000
CORS_ORIGIN=http://localhost:3000
# 1 عند العمل خلف HTTPS
COOKIE_SECURE=0

# مفتاح التكامل لاستقبال المشتريات والموردين من النظام الحالي (x-api-key)
# INTEGRATION_KEY=
# المهام الدورية كل ساعة (الانتهاء والتذكير والتصعيد وتثبيت الأهداف). 1 لإيقافها.
# JOBS_DISABLED=1
# البريد (اختياري). بدونه تبقى الإشعارات داخل النظام وتُسجَّل حالة البريد «skipped».
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
